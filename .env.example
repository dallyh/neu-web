# Public values are baked into prerendered pages at build time.
# Use hCaptcha's test site key locally; the development Action verifies with its test pair.
PUBLIC_SITE_URL=https://example.com
PUBLIC_HCAPTCHA_SITE_KEY=

# Public Umami settings are baked into pages. Set PREVIEW=true at build time
# for preview deployments to omit the tracker (development always omits it).
UMAMI_URL=https://analytics.daliborhon.dev
UMAMI_SITE_ID=7e04370d-ecba-4fd8-8d71-2d50880d0d59
PREVIEW=false

# Private values must be available to the Node server at runtime.
HCAPTCHA_SECRET=
RESEND_API_KEY=
# Use a sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional: only needed for server-side Umami API queries, not tracking.
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Required for Docker builds; authenticates project metadata requests to GitHub during the build.
GITHUB_TOKEN=
