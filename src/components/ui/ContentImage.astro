---
import { Image } from "astro:assets";

interface Props {
	src: ImageMetadata | string;
	alt: string;
	width?: number;
	height?: number;
	loading?: "eager" | "lazy";
	decoding?: "async" | "auto" | "sync";
	class?: string;
	title?: string;
}

const { src, alt, width, height, loading = "lazy", decoding = "async", class: className, title } = Astro.props;
---

{typeof src === "string" ? (
	<img {src} {alt} {title} width={width ?? 1536} height={height ?? 1024} {loading} {decoding} class={className} />
) : (
	<Image {src} {alt} {title} {width} {height} {loading} {decoding} class={className} />
)}
