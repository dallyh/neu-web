---
import type { CollectionEntry } from "astro:content";
import { useIntlayer, useLocale } from "astro-intlayer";
import ContentCard from "../ContentCard.astro";
import { sectionUrl } from "../../lib/urls";

type Props = { entries: CollectionEntry<"blog">[] };
const { entries } = Astro.props;
const ui = useIntlayer("site");
const { locale } = useLocale();
---

<section aria-labelledby="newest-posts-heading">
	<div class="my-8 mt-16 flex flex-wrap items-center justify-between gap-6">
		<h2 id="newest-posts-heading" class="font-nb-heading text-nb-h2 leading-tight font-bold">
			{ui.latestWriting}
		</h2>
		<a class="underline decoration-2 underline-offset-4" href={sectionUrl("blog", locale)}>
			{ui.viewAllArticles} ↗
		</a>
	</div>
	{entries.length ? (
		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{entries.map((entry, index) => (
				<ContentCard entry={entry} collection="blog" priority={index === 0} />
			))}
		</div>
	) : (
		<p>{ui.emptyArticles}</p>
	)}
</section>
