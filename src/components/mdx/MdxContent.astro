---
import type { MarkdownHeading } from "astro";
import type { render } from "astro:content";
import Callout from "./Callout.astro";
import Image from "./Image.astro";
import Link from "./Link.astro";
import TableOfContents from "./TableOfContents.astro";
import Heading1 from "./Heading1.astro";
import Heading2 from "./Heading2.astro";
import Heading3 from "./Heading3.astro";
import Heading4 from "./Heading4.astro";
import Heading5 from "./Heading5.astro";
import Heading6 from "./Heading6.astro";

interface Props {
	Content: Awaited<ReturnType<typeof render>>["Content"];
	headings: MarkdownHeading[];
	showTableOfContents?: boolean;
}

const { Content, headings, showTableOfContents = false } = Astro.props;
const components = { h1: Heading1, h2: Heading2, h3: Heading3, h4: Heading4, h5: Heading5, h6: Heading6, a: Link, img: Image, Callout };
---

<div class="prose dark:prose-invert print:prose-neutral nb-prose max-w-none">
	{showTableOfContents && (
		<div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,1fr)_23rem]">
			<aside class="not-prose order-1 xl:order-2">
				<div class="xl:sticky xl:top-2">
					<TableOfContents {headings} />
				</div>
			</aside>
			<article class="order-2 min-w-0 xl:order-1 [&>h1:first-child]:mt-0">
				<Content {components} />
			</article>
		</div>
	)}
	{!showTableOfContents && (
		<article>
			<Content {components} />
		</article>
	)}
</div>
