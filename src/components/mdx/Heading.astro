---
import { useIntlayer } from "astro-intlayer";

interface Props {
	id?: string;
	level: 1 | 2 | 3 | 4 | 5 | 6;
}

const { id, level } = Astro.props;
const Tag = `h${level}` as keyof HTMLElementTagNameMap;
const ui = useIntlayer("site");
---

<Tag {id} class="group scroll-mt-24">
	{id && (
		<a
			href={`#${id}`}
			aria-label={ui.headingPermalink}
			class="nb-heading-anchor mr-2 inline-block font-nb-mono text-[0.75em] no-underline opacity-60 group-hover:opacity-100 focus-visible:opacity-100 print:hidden"
		>
			#
		</a>
	)}
	<slot />
</Tag>
