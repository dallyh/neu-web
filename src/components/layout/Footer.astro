---
import { useIntlayer, useLocale } from "astro-intlayer";
import { getPrivacyPolicies, privacyPolicyLocale, privacyPolicyUrl } from "../../lib/privacy";
import { rssUrl } from "../../lib/urls";
const ui = useIntlayer("site");
const { locale } = useLocale();
const policy = (await getPrivacyPolicies()).find((entry) => privacyPolicyLocale(entry) === locale);
---

<footer class="mt-8 flex flex-col sm:flex-row justify-between border-t-[3px] border-nb-ink py-6 font-nb-mono text-nb-meta print:hidden">
	<div class="flex w-full flex-col">
		<p>
			© {new Date().getFullYear()} - {ui.name}
		</p>
		<p>{ui.footer}</p>
		<p>
			{ui.footerNeuStyleText}{" "}
			<a href="https://neubrutalism.com/" target="_blank" class="font-nb-display tracking-widest decoration-1 underline-offset-2 leading-3">
				neubrutalism<span class="text-nb-accent text-2xl leading-3">.</span>com
			</a>
		</p>
	</div>
	<div class="flex w-full flex-col sm:text-end">
		<a class="underline decoration-1 underline-offset-2" href={rssUrl(locale)}>
			{ui.rss}
		</a>
		<a class="underline decoration-1 underline-offset-2" href="https://analytics.daliborhon.dev/share/PLvxy1iAjOUgirKl" target="_blank">
			{ui.statisticsLink}
		</a>
		{policy && (
			<a class="underline decoration-1 underline-offset-2" href={privacyPolicyUrl(policy)}>
				{ui.privacyPolicy}
			</a>
		)}
	</div>
</footer>
