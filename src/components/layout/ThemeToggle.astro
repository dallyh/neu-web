---
import { useIntlayer } from "astro-intlayer";
import { Icon } from "astro-iconset/components";
const ui = useIntlayer("site");
---

<button
	class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center border-2 border-nb-ink bg-transparent p-2 text-nb-text hover:bg-nb-surface-muted"
	type="button"
	aria-label={ui.theme}
	title={ui.theme}
	data-theme-toggle
>
	<span class="grid h-6 w-6" aria-hidden="true">
		<Icon name="moon" size={24} class="nb-theme-icon-moon" aria-hidden="true" />
		<Icon name="sun" size={24} class="nb-theme-icon-sun" aria-hidden="true" />
	</span>
</button>

<style>
	.nb-theme-icon-moon,
	.nb-theme-icon-sun {
		grid-area: 1 / 1;
		transform-origin: center;
		pointer-events: none;
		transition-property: none;
	}
	.nb-theme-icon-moon {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
	.nb-theme-icon-sun {
		opacity: 0;
		transform: rotate(90deg) scale(0);
	}
	:global(:root[data-theme="dark"]) .nb-theme-icon-moon {
		opacity: 0;
		transform: rotate(-90deg) scale(0);
	}
	:global(:root[data-theme="dark"]) .nb-theme-icon-sun {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .nb-theme-icon-sun {
			opacity: 1;
			transform: rotate(0deg) scale(1);
		}
		:global(:root:not([data-theme])) .nb-theme-icon-moon {
			opacity: 0;
			transform: rotate(-90deg) scale(0);
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.nb-theme-icon-moon,
		.nb-theme-icon-sun {
			transition:
				transform var(--nb-duration-slow) var(--nb-ease),
				opacity var(--nb-duration-slow) var(--nb-ease);
		}
	}
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
	button?.addEventListener("click", () => {
		const dark = document.documentElement.dataset.theme === "dark" || (!document.documentElement.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
		const next = dark ? "light" : "dark";
		document.documentElement.dataset.theme = next;
		localStorage.setItem("theme", next);
	});
</script>
