---
import { useIntlayer, useLocale } from "astro-intlayer";
import { getPathWithoutLocale } from "intlayer";
import { sectionUrl } from "../../lib/urls";
import { Icon } from "astro-iconset/components";
import wordmark from "../../icons/dalibor-hon.svg?raw";

const ui = useIntlayer("site");
const { locale } = useLocale();
const path = getPathWithoutLocale(Astro.url.pathname);
const section = path.startsWith("/about/cv") ? "cv" : path.startsWith("/about") ? "about" : path.startsWith("/blog") || path.startsWith("/tags") ? "blog" : path.startsWith("/portfolio") ? "portfolio" : "";
const navLinkClass = "nb-action nb-action-accent nb-action-anim-shadow shadow-nb-offset-sm border-nb-ink w-full px-3 py-2 text-sm lg:w-auto";
---

<header class="mt-2 mb-8 flex flex-wrap items-center gap-4 nb-card nb-card-no-action p-4 max-lg:mb-10 print:hidden" data-site-header>
	<a class="nb-brand mr-auto inline-flex no-underline" href={sectionUrl("", locale)} aria-label={ui.name}>
		<span class="nb-card nb-card-no-action shadow-nb-offset-sm inline-flex min-h-11 items-center justify-start p-2" aria-hidden="true">
			<span class="nb-brand-viewport">
				<Fragment set:html={wordmark} />
			</span>
		</span>
	</a>
	<button
		class="nb-menu-toggle group inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center border-2 border-nb-ink bg-nb-primary p-2 text-nb-on-primary hover:bg-nb-secondary lg:hidden"
		type="button"
		aria-controls="site-menu"
		aria-expanded="false"
		aria-label={ui.openMenu}
		data-label-open={ui.openMenu}
		data-label-close={ui.closeMenu}
		data-menu-toggle
	>
		<Icon name="menu" size={24} class="group-aria-[expanded=true]:hidden" aria-hidden="true" />
		<Icon name="close" size={24} class="hidden group-aria-[expanded=true]:block" aria-hidden="true" />
	</button>
	<div
		id="site-menu"
		class="nb-header-menu-nojs hidden w-full flex-col gap-4 border-t-2 border-nb-ink pt-4 lg:ml-auto lg:flex lg:w-auto lg:flex-row lg:flex-wrap lg:items-center lg:border-0 lg:pt-0"
		data-menu-panel
	>
		<nav class="flex w-full flex-col gap-3 lg:w-auto lg:flex-row lg:flex-wrap lg:items-center" aria-label={ui.navigation}>
			<a class:list={[navLinkClass, "aria-[current=page]:bg-nb-primary"]} href={sectionUrl("", locale)} aria-current={section === "" ? "page" : undefined}>
				{ui.home}
			</a>
			<a class:list={[navLinkClass, "aria-[current=page]:bg-nb-secondary"]} href={sectionUrl("portfolio", locale)} aria-current={section === "portfolio" ? "page" : undefined}>
				{ui.portfolio}
			</a>
			<a class:list={[navLinkClass, "aria-[current=page]:bg-nb-warning"]} href={sectionUrl("blog", locale)} aria-current={section === "blog" ? "page" : undefined}>
				{ui.blog}
			</a>
			<a class:list={[navLinkClass, "aria-[current=page]:bg-nb-success"]} href={sectionUrl("about", locale)} aria-current={section === "about" ? "page" : undefined}>
				{ui.about}
			</a>
			<a class:list={[navLinkClass, "aria-[current=page]:bg-nb-lavender"]} href={sectionUrl("about/cv", locale)} aria-current={section === "cv" ? "page" : undefined}>
				{ui.cv}
			</a>
		</nav>
		<div class="flex flex-wrap items-center gap-3 border-t-2 border-nb-ink pt-4 lg:border-0 lg:pt-0">
			<slot />
		</div>
	</div>
</header>

<style>
	.nb-brand {
		--nb-wordmark-height: 24px;
		--nb-wordmark-width: calc(152 / 116 * var(--nb-wordmark-height));
		--nb-wordmark-shift: -464px;
		--nb-wordmark-clip: inset(0 100% 0 0);
	}

	.nb-brand-viewport {
		display: block;
		width: var(--nb-wordmark-width);
		height: var(--nb-wordmark-height);
		overflow: hidden;
		transition: width var(--nb-duration-slowest) var(--nb-ease);
	}

	.nb-brand-viewport :global(svg) {
		display: block;
		width: calc(784 / 116 * var(--nb-wordmark-height));
		max-width: none;
		height: var(--nb-wordmark-height);
	}

	.nb-brand-viewport :global([data-wordmark-surname]) {
		transform: translateX(var(--nb-wordmark-shift));
		transition: transform var(--nb-duration-slowest) var(--nb-ease);
	}

	.nb-brand-viewport :global([data-wordmark-alibor]),
	.nb-brand-viewport :global([data-wordmark-on]) {
		clip-path: var(--nb-wordmark-clip);
		transition: clip-path var(--nb-duration-slowest) var(--nb-ease);
	}

	.nb-brand:focus-visible {
		--nb-wordmark-width: calc(784 / 116 * var(--nb-wordmark-height));
		--nb-wordmark-shift: 0px;
		--nb-wordmark-clip: inset(0 0 0 0);
	}

	@media (hover: hover) {
		.nb-brand:hover {
			--nb-wordmark-width: calc(784 / 116 * var(--nb-wordmark-height));
			--nb-wordmark-shift: 0px;
			--nb-wordmark-clip: inset(0 0 0 0);
		}
	}

	.nb-brand:is(:hover, :focus-visible) > span {
		background: var(--nb-primary);
		color: var(--nb-on-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.nb-brand-viewport,
		.nb-brand-viewport :global([data-wordmark-surname]),
		.nb-brand-viewport :global([data-wordmark-alibor]),
		.nb-brand-viewport :global([data-wordmark-on]) {
			transition: none;
		}
	}
</style>

<noscript>
	<style is:inline>
		@media (max-width: 63.999rem) {
			.nb-header-menu-nojs {
				display: flex !important;
			}
			.nb-menu-toggle {
				display: none !important;
			}
		}
	</style>
</noscript>

<script>
	const header = document.querySelector<HTMLElement>("[data-site-header]");
	const button = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const panel = header?.querySelector<HTMLElement>("[data-menu-panel]");
	const mobile = window.matchMedia("(max-width: 63.999rem)");

	function setMenuOpen(open: boolean): void {
		if (!button || !panel) return;
		button.setAttribute("aria-expanded", String(open));
		button.setAttribute("aria-label", open ? (button.dataset.labelClose ?? "") : (button.dataset.labelOpen ?? ""));
		panel.classList.toggle("hidden", !open);
	}

	button?.addEventListener("click", () => setMenuOpen(button.getAttribute("aria-expanded") !== "true"));
	header?.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && button?.getAttribute("aria-expanded") === "true") {
			setMenuOpen(false);
			button.focus();
		}
	});
	mobile.addEventListener("change", () => setMenuOpen(false));
</script>
