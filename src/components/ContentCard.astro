---
import type { CollectionEntry } from "astro:content";
import { useIntlayer, useLocale } from "astro-intlayer";
import { contentUrl } from "../lib/content";
import Tag from "./ui/Tag.astro";
import { getBlogTags, tagLabel, tagUrl } from "../lib/tags";
import type { GitHubProjectData } from "../lib/github";
import GitHubLanguages from "./portfolio/GitHubLanguages.astro";
import ContentImage from "./ui/ContentImage.astro";

type Props =
	| { entry: CollectionEntry<"blog">; collection: "blog"; priority?: boolean; headingLevel?: 2 | 3; class?: string }
	| { entry: CollectionEntry<"portfolio">; collection: "portfolio"; priority?: boolean; headingLevel?: 2 | 3; githubData?: GitHubProjectData; class?: string };
const props = Astro.props;
const { entry, collection, class: className } = props;
const Heading = props.headingLevel === 2 ? "h2" : "h3";
const ui = useIntlayer("site");
const { locale } = useLocale();
const date = props.collection === "blog" ? props.entry.data.publishedAt : (props.githubData?.createdAt ?? props.entry.data.date);
const href = props.collection === "blog" ? contentUrl("blog", props.entry) : contentUrl("portfolio", props.entry);
const blogTags = props.collection === "blog" ? await getBlogTags(props.entry) : [];
---

<article class:list={["nb-card flex h-full flex-col gap-4 relative", className]}>
	{entry.data.draft && <span class="absolute left-2 top-2 border-2 p-2 border-nb-ink bg-nb-warning font-nb-mono text-nb-meta font-bold uppercase text-nb-on-warning">{ui.draft}</span>}
	{entry.data.image && (
		<a href={href} class="block overflow-hidden border-2 border-nb-ink">
			<ContentImage
				src={entry.data.image}
				alt={entry.data.imageAlt ?? ""}
				width={1200}
				height={630}
				loading={props.priority ? "eager" : "lazy"}
				decoding="async"
				fit="contain"
				class="aspect-1200/630 max-h-96 w-full object-cover"
			/>
		</a>
	)}
	<p class="flex justify-between gap-4 font-nb-mono text-nb-meta leading-snug uppercase">
		<time datetime={date.toISOString()}>{new Intl.DateTimeFormat(locale, { year: "numeric", month: "long", day: "numeric" }).format(date)}</time>
		<span>{collection === "blog" ? ui.blog : ui.portfolio}</span>
	</p>
	<Heading class="font-nb-heading text-nb-h3 leading-tight font-bold">
		<a class="nb-marker-hover" data-text-marker={entry.data.title} href={href}>
			{entry.data.title}
		</a>
	</Heading>
	<p>{entry.data.description}</p>
	<div class="flex flex-wrap gap-2">
		{blogTags.map((tag) => (
			<Tag label={tagLabel(tag, locale)} href={tagUrl(tag, locale)} />
		))}
		{props.collection === "portfolio" && props.entry.data.tags.map((tag) => <Tag label={tag} />)}
	</div>
	{props.collection === "portfolio" && props.githubData && <GitHubLanguages languages={props.githubData.languages} />}
	<a class="mt-auto self-start font-bold underline decoration-2 underline-offset-4" href={href}>
		{collection === "blog" ? ui.readArticle : ui.readProject}
		<span aria-hidden="true"> ↗</span>
	</a>
</article>
