---
interface Props {
	date: string;
	title: string;
	institute: string;
}
const { date, title, institute } = Astro.props;
---

<li class="nb-card nb-card-warning relative ml-4 mb-8 pl-6 last:mb-0 print:break-inside-avoid">
	<span aria-hidden="true" class="absolute -top-1 -left-[28px] size-[15px] border-[3px] border-nb-ink bg-nb-primary print:hidden"></span>
	<p class="mb-2 font-nb-mono text-nb-meta text-nb-on-success-ink">{date}</p>
	<h4 class="mb-2 font-nb-heading text-xl leading-tight text-nb-on-success-ink font-bold">{title}</h4>
	<p class="mb-4 font-medium">{institute}</p>
	<div class="border-2 border-nb-ink bg-nb-surface-muted text-nb-text p-4 text-sm [&>p]:m-0 print:border-0 print:p-0">
		<slot />
	</div>
</li>
