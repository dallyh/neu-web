---
import { Icon } from "astro-iconset/components";
interface Props {
	label: string;
	iconName: string;
}
const { label, iconName } = Astro.props;
---

<li class="nb-card nb-card-lavender flex min-w-0 flex-col items-center gap-3 p-4 text-center print:flex-row print:border-0 print:p-0 print:text-left">
	<div class="flex size-16 items-center justify-center print:hidden">
		<Icon name={`devicon:${iconName}`} size={48} aria-hidden="true" />
	</div>
	<span class="font-nb-heading text-sm font-bold">{label}</span>
</li>
