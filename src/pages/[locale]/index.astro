---
import { locales } from "intlayer";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentGrid from "../../components/ui/ContentGrid.astro";
import ProjectCard from "../../components/portfolio/ProjectCard.astro";
import { getEntries } from "../../lib/content";
import { sectionUrl } from "../../lib/urls";
import ContentCard from "../../components/ContentCard.astro";

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale!;
const ui = useIntlayer("site");
const projects = await getEntries("portfolio", locale);
const articles = await getEntries("blog", locale);
const featuredProjects = projects.filter((entry) => entry.data.featured).slice(0, 3);
const featuredPosts = articles.filter((entry) => entry.data.featured).slice(0, 3);
const newestPosts = articles.slice(0, 3);
const paths = Object.fromEntries(locales.map((target) => [target, sectionUrl("", target)]));
const sectionHeadingClass = "my-8 mt-16 flex flex-wrap items-center justify-between gap-6";
---

<BaseLayout title={ui.name} description={ui.heroText} paths={paths}>
	<section class="grid items-end gap-8 py-8 pb-10 md:grid-cols-[minmax(0,3fr)_minmax(16rem,2fr)] md:gap-12 md:pb-20" aria-labelledby="hero-title">
		<h1 id="hero-title" class="max-w-[11ch] font-nb-display text-nb-display-xl leading-[1.05] font-normal tracking-[-.04em]">
			{ui.heroTitle}
		</h1>
		<div class="nb-card nb-card-primary nb-card-no-action">
			<p class="text-lg mb-4">{ui.heroText}</p>
			<div class="flex flex-wrap items-center gap-6">
				<a class="nb-action nb-action-secondary nb-shadow -rotate-4" href={sectionUrl("portfolio", locale)}>
					{ui.viewAllProjects}
				</a>
				<a class="nb-action nb-action-warning nb-shadow -rotate-12 md:rotate-12 -translate-y-3 translate-x-4 mt-6" href={sectionUrl("blog", locale)}>
					{ui.viewAllArticles}
				</a>
			</div>
		</div>
	</section>
	<section aria-labelledby="featured-posts-heading">
		<div class={sectionHeadingClass}>
			<h2 id="featured-posts-heading" class="font-nb-heading text-nb-h2 leading-tight font-bold">
				{ui.featuredPosts}
			</h2>
			<a class="underline decoration-2 underline-offset-4" href={sectionUrl("blog", locale)}>
				{ui.viewAllArticles} ↗
			</a>
		</div>
		{featuredPosts.length ? (
			<ContentGrid>
				{featuredPosts.map((entry, index) => (
					<ContentCard entry={entry} collection="blog" priority={index === 0} />
				))}
			</ContentGrid>
		) : (
			<p>{ui.emptyArticles}</p>
		)}
	</section>
	<section aria-labelledby="work-heading">
		<div class={sectionHeadingClass}>
			<h2 id="work-heading" class="font-nb-heading text-nb-h2 leading-tight font-bold">
				{ui.selectedWork}
			</h2>
			<a class="underline decoration-2 underline-offset-4" href={sectionUrl("portfolio", locale)}>
				{ui.viewAllProjects} ↗
			</a>
		</div>
		{featuredProjects.length ? (
			<ContentGrid>
				{featuredProjects.map((entry, index) => (
					<ProjectCard entry={entry} priority={index === 0} />
				))}
			</ContentGrid>
		) : (
			<p>{ui.emptyProjects}</p>
		)}
	</section>
	<section aria-labelledby="newest-posts-heading">
		<div class={sectionHeadingClass}>
			<h2 id="newest-posts-heading" class="font-nb-heading text-nb-h2 leading-tight font-bold">
				{ui.latestWriting}
			</h2>
			<a class="underline decoration-2 underline-offset-4" href={sectionUrl("blog", locale)}>
				{ui.viewAllArticles} ↗
			</a>
		</div>
		{newestPosts.length ? (
			<ContentGrid>
				{newestPosts.map((entry, index) => (
					<ContentCard entry={entry} collection="blog" priority={index === 0} />
				))}
			</ContentGrid>
		) : (
			<p>{ui.emptyArticles}</p>
		)}
	</section>
</BaseLayout>
