---
import { getEntries, getTranslations, contentUrl, getSlugWithoutLocale } from "../../../lib/content";
import { sectionUrl } from "../../../lib/urls";
import { render } from "astro:content";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Tag from "../../../components/ui/Tag.astro";
import MdxContent from "../../../components/mdx/MdxContent.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import ContentImage from "../../../components/ui/ContentImage.astro";
import ExternalLink from "../../../components/mdx/ExternalLink.astro";
import { Icon } from "astro-iconset/components";

export async function getStaticPaths() {
	return (await getEntries("portfolio")).map((entry) => ({ params: { locale: entry.data.locale, slug: getSlugWithoutLocale(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const ui = useIntlayer("site");
const translations = await getTranslations("portfolio", entry.data.translationKey);
const paths = Object.fromEntries(translations.map((sibling) => [sibling.data.locale, contentUrl("portfolio", sibling)]));
---

<BaseLayout searchable title={`${entry.data.title} · ${ui.name}`} description={entry.data.description} paths={paths} fallbackPath="/portfolio/">
	<article>
		<PageHeader class="my-8 mb-12 nb-card nb-card-secondary nb-card-no-action">
			<p class="nb-page-header-label">{ui.portfolio}</p>
			<h1 class="nb-page-header-title" data-pagefind-meta="title">
				{entry.data.title}
			</h1>
			<p class="nb-page-header-description mb-4">{entry.data.description}</p>
			{entry.data.githubUrl && (
				<ExternalLink href={entry.data.githubUrl} class="text-sm nb-action nb-action-primary nb-shadow w-fit gap-2">
					<Icon name="github" size={20} aria-hidden="true" />
					{ui.viewOnGitHub}
				</ExternalLink>
			)}
		</PageHeader>
		{entry.data.image && (
			<figure class="mt-8 overflow-hidden border-2 border-nb-ink">
				<ContentImage src={entry.data.image} alt={entry.data.imageAlt ?? ""} width={1536} height={1024} class="max-h-[34rem] w-full object-cover" />
			</figure>
		)}
		<div class="mb-8 flex flex-col flex-wrap gap-4 font-nb-mono text-nb-meta">
			<div class="flex gap-2">
				{entry.data.tags.map((tag) => (
					<Tag label={tag} />
				))}
			</div>
			{entry.data.role && (
				<div>
					{ui.role}: {entry.data.role}
				</div>
			)}
			<div class="flex">
				{ui.stack}: {entry.data.stack.join(", ")}
			</div>
		</div>
		<MdxContent {Content} {headings} showTableOfContents={entry.data.showTableOfContents} />
	</article>
	<a class="mt-6 inline-block font-bold underline decoration-2 underline-offset-4 print:hidden" href={sectionUrl("portfolio", entry.data.locale)}>
		← {ui.backToPortfolio}
	</a>
</BaseLayout>
