---
import { locales } from "intlayer";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentCard from "../../../components/ContentCard.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import { getPostsByTag, getTags, tagDescription, tagLabel, tagUrl } from "../../../lib/tags";
import { sectionUrl } from "../../../lib/urls";

export async function getStaticPaths() {
	const tags = await getTags();
	return locales.flatMap((locale) => tags.map((tag) => ({ params: { locale, slug: tag.id }, props: { tag } })));
}
const { tag } = Astro.props;
const locale = Astro.params.locale!;
const ui = useIntlayer("site");
const posts = await getPostsByTag(tag.id, locale);
const paths = Object.fromEntries(locales.map((target) => [target, tagUrl(tag, target)]));
---

<BaseLayout title={`${tagLabel(tag, locale)} · ${ui.blog} · ${ui.name}`} description={tagDescription(tag, locale)} paths={paths} fallbackPath="/tags/">
	<PageHeader class="mb-12">
		<p class="nb-page-header-label">{ui.tags}</p>
		<h1 class="nb-page-header-title">{tagLabel(tag, locale)}</h1>
		<p class="nb-page-header-description">{tagDescription(tag, locale)}</p>
	</PageHeader>
	<h2 class="mb-8 font-nb-heading text-nb-h2 leading-tight font-bold">{ui.taggedPosts}</h2>
	{posts.length ? (
		<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,21rem),1fr))] gap-8">
			{posts.map((entry, index) => (
				<ContentCard entry={entry} collection="blog" priority={index === 0} />
			))}
		</div>
	) : (
		<p>{ui.noTaggedPosts}</p>
	)}
	<a class="my-12 inline-block font-bold underline decoration-2 underline-offset-4" href={sectionUrl("tags", locale)}>
		← {ui.backToTags}
	</a>
</BaseLayout>
