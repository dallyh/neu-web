---
import { render } from "astro:content";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MdxContent from "../../components/mdx/MdxContent.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import { getPrivacyPolicies, privacyPolicyLocale, privacyPolicyUrl, type PrivacyPolicyEntry } from "../../lib/privacy";

interface Props {
	entry: PrivacyPolicyEntry;
}

export async function getStaticPaths() {
	return (await getPrivacyPolicies()).map((entry) => ({
		params: { locale: privacyPolicyLocale(entry), slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const ui = useIntlayer("site");
const paths = Object.fromEntries(
	(await getPrivacyPolicies()).filter((policy) => policy.data.translationKey === entry.data.translationKey).map((policy) => [privacyPolicyLocale(policy), privacyPolicyUrl(policy)]),
);
---

<BaseLayout title={`${entry.data.title} · ${ui.name}`} description={ui.privacyPolicyDescription} paths={paths}>
	<article>
		<PageHeader class="my-8 mb-12">
			<h1 class="nb-page-header-title">{entry.data.title}</h1>
			<p class="nb-page-header-description">
				{ui.effectiveDate}: <time datetime={entry.data.effectiveDate.toISOString()}>{new Intl.DateTimeFormat(privacyPolicyLocale(entry), { dateStyle: "long" }).format(entry.data.effectiveDate)}</time>
			</p>
		</PageHeader>
		<MdxContent {Content} {headings} />
	</article>
</BaseLayout>
