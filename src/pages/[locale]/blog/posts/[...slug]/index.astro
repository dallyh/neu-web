---
import { getEntries, getTranslations, contentUrl, getSlugWithoutLocale } from "../../../../../lib/content";
import { sectionUrl } from "../../../../../lib/urls";
import { render } from "astro:content";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Tag from "../../../../../components/ui/Tag.astro";
import MdxContent from "../../../../../components/mdx/MdxContent.astro";
import PageHeader from "../../../../../components/ui/PageHeader.astro";
import ContentImage from "../../../../../components/ui/ContentImage.astro";
import { getBlogTags, tagLabel, tagUrl } from "../../../../../lib/tags";
import { blogOgUrl } from "../../../../../lib/open-graph/urls";
import ViewCount from "../../../../../components/blog/ViewCount.astro";
import ReadingStats from "../../../../../components/blog/ReadingStats.astro";
import Comments from "../../../../../components/blog/Comments.astro";

export async function getStaticPaths() {
	return (await getEntries("blog")).map((entry) => ({ params: { locale: entry.data.locale, slug: getSlugWithoutLocale(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const ui = useIntlayer("site");
const translations = await getTranslations("blog", entry.data.translationKey);
const paths = Object.fromEntries(translations.map((sibling) => [sibling.data.locale, contentUrl("blog", sibling)]));
const tags = await getBlogTags(entry);
---

<BaseLayout
	title={`${entry.data.title} · ${ui.name}`}
	description={entry.data.description}
	paths={paths}
	fallbackPath="/blog/"
	articleDate={entry.data.publishedAt}
	ogImage={blogOgUrl(entry)}
	ogImageAlt={entry.data.title}
>
	<article>
		<PageHeader class="nb-card nb-card-primary nb-card-no-action">
			<div class="flex flex-col gap-4 xl:flex-row xl:items-center">
				<div class="xl:max-w-[60%]">
					<p class="nb-page-header-label">{ui.blog}</p>
					<h1 class="nb-page-header-title">{entry.data.title}</h1>
					<p class="nb-page-header-description">{entry.data.description}</p>
				</div>

				{entry.data.image && (
					<div class="xl:flex xl:flex-1 xl:justify-end">
						<figure class="w-full overflow-hidden nb-card p-0 nb-shadow xl:max-w-md">
							<ContentImage src={entry.data.image} alt={entry.data.imageAlt ?? ""} width={1200} height={600} class="h-auto w-full object-cover" />
						</figure>
					</div>
				)}
			</div>
		</PageHeader>

		<div class="my-6 mb-12 flex flex-col flex-wrap gap-0 font-nb-mono text-nb-meta">
			<span>
				{ui.published}: <time datetime={entry.data.publishedAt.toISOString()}>{new Intl.DateTimeFormat(entry.data.locale, { dateStyle: "long" }).format(entry.data.publishedAt)}</time>
			</span>
			<ViewCount server:defer pathname={Astro.url.pathname}>
				<span slot="fallback" class="skeleton max-w-fit">
					{ui.viewCount}: 9999
				</span>
			</ViewCount>
			<ReadingStats post={entry} />
			<div class="flex flex-wrap gap-2 mt-2">
				{tags.map((tag) => (
					<Tag label={tagLabel(tag, entry.data.locale)} href={tagUrl(tag, entry.data.locale)} />
				))}
			</div>
		</div>
		<MdxContent {Content} {headings} showTableOfContents={entry.data.showTableOfContents} />
		<Comments />
	</article>
	<a class="mt-6 inline-block font-bold underline decoration-2 underline-offset-4 print:hidden" href={sectionUrl("blog", entry.data.locale)}>
		← {ui.backToBlog}
	</a>
</BaseLayout>
