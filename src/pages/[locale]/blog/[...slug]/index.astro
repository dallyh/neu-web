---
import { getEntries, getTranslations, contentUrl } from "../../../../lib/content";
import { sectionUrl } from "../../../../lib/urls";
import { render } from "astro:content";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Tag from "../../../../components/ui/Tag.astro";
import MdxContent from "../../../../components/mdx/MdxContent.astro";
import PageHeader from "../../../../components/ui/PageHeader.astro";
import ContentImage from "../../../../components/ui/ContentImage.astro";
import { getBlogTags, tagLabel, tagUrl } from "../../../../lib/tags";
import { blogOgUrl } from "../../../../lib/open-graph/urls";

export async function getStaticPaths() {
	return (await getEntries("blog")).map((entry) => ({ params: { locale: entry.data.locale, slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const ui = useIntlayer("site");
const translations = await getTranslations("blog", entry.data.translationKey);
const paths = Object.fromEntries(translations.map((sibling) => [sibling.data.locale, contentUrl("blog", sibling)]));
const tags = await getBlogTags(entry);
---

<BaseLayout
	title={`${entry.data.title} · ${ui.name}`}
	description={entry.data.description}
	paths={paths}
	fallbackPath="/blog/"
	articleDate={entry.data.publishedAt}
	ogImage={blogOgUrl(entry)}
	ogImageAlt={entry.data.title}
>
	<article>
		<PageHeader>
			<p class="nb-page-header-label">{ui.blog}</p>
			<h1 class="nb-page-header-title">{entry.data.title}</h1>
			<p class="nb-page-header-description">{entry.data.description}</p>
		</PageHeader>
		{entry.data.image && (
			<figure class="mt-8 overflow-hidden border-2 border-nb-ink">
				<ContentImage src={entry.data.image} alt={entry.data.imageAlt ?? ""} width={1536} height={1024} class="max-h-[34rem] w-full object-cover" />
			</figure>
		)}
		<div class="my-6 mb-12 flex flex-col flex-wrap gap-4 font-nb-mono text-nb-meta">
			<span>
				{ui.published}: <time datetime={entry.data.publishedAt.toISOString()}>{new Intl.DateTimeFormat(entry.data.locale, { dateStyle: "long" }).format(entry.data.publishedAt)}</time>
			</span>
			<div class="flex flex-wrap gap-2">
				{tags.map((tag) => (
					<Tag label={tagLabel(tag, entry.data.locale)} href={tagUrl(tag, entry.data.locale)} />
				))}
			</div>
		</div>
		<MdxContent {Content} {headings} showTableOfContents={entry.data.showTableOfContents} />
	</article>
	<a class="my-12 inline-block font-bold underline decoration-2 underline-offset-4 print:hidden" href={sectionUrl("blog", entry.data.locale)}>
		← {ui.backToBlog}
	</a>
</BaseLayout>
