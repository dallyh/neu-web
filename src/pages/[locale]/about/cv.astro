---
import { render } from "astro:content";
import type { LocalesValues } from "intlayer";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getResumes, type ResumeEntry } from "../../../lib/resume";
import { sectionUrl } from "../../../lib/urls";
import MdxContent from "../../../components/mdx/MdxContent.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";

interface Props {
	resume: ResumeEntry;
}

export async function getStaticPaths() {
	return (await getResumes()).map((resume) => ({ params: { locale: resume.data.locale }, props: { resume } }));
}

const { resume } = Astro.props;
const { Content, headings } = await render(resume);
const locale = resume.data.locale as LocalesValues;
const ui = useIntlayer("site");
const paths = Object.fromEntries(
	(await getResumes()).filter((entry) => entry.data.translationKey === resume.data.translationKey).map((entry) => [entry.data.locale, sectionUrl("about/cv", entry.data.locale as LocalesValues)]),
);
---

<BaseLayout title={`${resume.data.title} · ${ui.name}`} description={resume.data.description} paths={paths} fallbackPath="/about/cv/">
	<article class="nb-cv">
		<PageHeader class="mb-12 nb-card nb-card-lavender nb-card-no-action print:mb-6 relative">
			<p class="nb-page-header-label print:hidden">{ui.about}</p>
			<div class="flex justify-between">
				<h1 class="nb-page-header-title">{resume.data.title}</h1>
				<button class="nb-action nb-action-primary nb-shadow max-h-fit rotate-12 print:hidden -translate-y-4" onclick="window.print()">{ui.printMe}</button>
			</div>
			<p class="nb-page-header-description">{resume.data.description}</p>
		</PageHeader>
		<MdxContent {Content} {headings} showTableOfContents={resume.data.showTableOfContents} />
	</article>
	<a class="mt-6 inline-block font-bold underline decoration-2 underline-offset-4 print:hidden" href={sectionUrl("about", locale)}>
		← {ui.about}
	</a>
</BaseLayout>
