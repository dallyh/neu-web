---
import type { LocalesValues } from "intlayer";
import { useIntlayer } from "astro-intlayer";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContactForm from "../../../components/ContactForm.astro";
import ContactLinks from "../../../components/about/ContactLinks.astro";
import PageHeader from "../../../components/ui/PageHeader.astro";
import { getResumes, type ResumeEntry } from "../../../lib/resume";
import { sectionUrl } from "../../../lib/urls";

interface Props {
	resume: ResumeEntry;
}

export async function getStaticPaths() {
	return (await getResumes()).map((resume) => ({ params: { locale: resume.data.locale }, props: { resume } }));
}

const { resume } = Astro.props;
const locale = resume.data.locale as LocalesValues;
const ui = useIntlayer("site");
const paths = Object.fromEntries((await getResumes()).map((entry) => [entry.data.locale, sectionUrl("about", entry.data.locale as LocalesValues)]));
---

<BaseLayout title={`${ui.about} · ${ui.name}`} description={ui.aboutDescription} paths={paths} fallbackPath="/about/">
	<PageHeader class="mb-12 nb-card nb-card-success nb-card-no-action">
		<h1 class="nb-page-header-title">{ui.about}</h1>
		<p class="nb-page-header-description">{ui.aboutDescription}</p>
	</PageHeader>
	<div class="grid items-start grid-cols-1 gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(19rem,3fr)]">
		<section aria-labelledby="about-me-heading" class="nb-card nb-card-secondary nb-card-no-action flex flex-col">
			<h2 id="about-me-heading" class="mb-5 font-nb-heading text-nb-h2 leading-tight font-bold">
				{ui.aboutMe}
			</h2>
			<p class="mb-8 text-lg">{resume.data.summary}</p>
			<a class="nb-action nb-action-primary nb-shadow self-end -rotate-12 -translate-y-3" href={sectionUrl("about/cv", locale)}>
				{ui.viewCv}
			</a>
		</section>
		<ContactLinks />
		<section aria-labelledby="contact-heading" class="lg:col-span-2">
			<h2 id="contact-heading" class="mb-3 font-nb-heading text-nb-h2 leading-tight font-bold">
				{ui.contact}
			</h2>
			<p class="mb-6">{ui.contactIntro}</p>
			<ContactForm />
		</section>
	</div>
</BaseLayout>
