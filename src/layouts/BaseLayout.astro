---
import { useIntlayer, useLocale } from "astro-intlayer";
import { Font } from "astro:assets";
import { UMAMI_URL, UMAMI_SITE_ID } from "astro:env/client";
import { PREVIEW } from "astro:env/server";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import LocaleSwitcher from "../components/layout/LocaleSwitcher.astro";
import ThemeToggle from "../components/layout/ThemeToggle.astro";
import { rssUrl } from "../lib/urls";
import { websiteOgUrl } from "../lib/open-graph/urls";
import { ogSize } from "../lib/open-graph/theme";
import "../styles/tailwind.css";

interface Props {
	title: string;
	description: string;
	paths?: Record<string, string>;
	fallbackPath?: string;
	articleDate?: Date;
	ogImage?: string;
	ogImageAlt?: string;
}
const { title, description, paths = {}, fallbackPath = "/", articleDate, ogImage, ogImageAlt = title } = Astro.props;
const { locale, availableLocales } = useLocale();
const ui = useIntlayer("site");
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const imageUrl = new URL(ogImage ?? websiteOgUrl(locale), Astro.site ?? Astro.url).href;
const analyticsEnabled = !PREVIEW && !import.meta.env.DEV;
const analyticsScript = `${UMAMI_URL.replace(/\/$/, "")}/script.js`;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Font cssVariable="--font-bebas-neue" />
		<Font cssVariable="--font-plus-jakarta-sans" />
		<Font cssVariable="--font-dm-sans" preload={[{ weight: "100 1000", style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-jetbrains-mono" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={ui.rssTitle} href={new URL(rssUrl(locale), Astro.site ?? Astro.url).href} />
		{availableLocales
			.filter((target) => paths[target])
			.map((target) => (
				<link rel="alternate" hreflang={target} href={new URL(paths[target], Astro.site ?? Astro.url).href} />
			))}
		<meta property="og:type" content={articleDate ? "article" : "website"} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(ogSize.width)} />
		<meta property="og:image:height" content={String(ogSize.height)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
		{analyticsEnabled && <script is:inline defer src={analyticsScript} data-website-id={UMAMI_SITE_ID} />}
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme");
				if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
	</head>
	<body>
		<a class="absolute -top-20 left-4 z-10 bg-nb-primary p-2 text-nb-on-primary focus:top-4" href="#main">
			{ui.skip}
		</a>
		<div class="px-4 mx-auto w-full max-w-[80rem] print:max-w-none print:px-0 lg:px-0">
			<Header>
				<LocaleSwitcher paths={paths} fallbackPath={fallbackPath} />
				<ThemeToggle />
			</Header>
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
		::view-transition-old(root),
		::view-transition-new(root) {
			animation-duration: var(--nb-duration);
		}
	}
</style>
